[Unit]
Description=Back up the ERP database
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Environment=BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile/erp_backup.prom
ExecStart=/srv/apps/erp/backup/backup.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
