APP_NAME=ERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
FRONTEND_URL=http://localhost:5176

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the `postgres` service in docker-compose.yml — dev-only credentials.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Authenticated API requests per user per minute. Keep 120 in production; raise it only on the dev stack that runs the
# Playwright suite (one scripted user opens dozens of screens a minute).
API_RATE_LIMIT_PER_MINUTE=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production must set this to true — the session and XSRF-TOKEN cookies are
# otherwise sent without the Secure flag over an HTTPS site. Left false in dev
# because dev is plain HTTP on localhost.
SESSION_SECURE_COOKIE=false
# Also set TRUSTED_PROXIES in production (comma-separated, or '*' when the
# container is only reachable through Traefik) — see bootstrap/app.php.
# TRUSTED_PROXIES=*

# The SPA's origin(s) — cookie auth (Sanctum) and CORS both need these to match.
# The 10.*/172.*/192.168.* wildcards let a phone on the same LAN reach this dev
# stack at http://<this-machine's-LAN-IP>:5176 (Sanctum's stateful-domain match
# supports Str::is-style '*' globs; CORS needs the separate regex pattern below
# since allowed_origins only does exact string matches). Dev-only convenience —
# a real deployment sets its own exact domain here, never this file.
SANCTUM_STATEFUL_DOMAINS=localhost:5176,localhost:8090,127.0.0.1:5176,127.0.0.1:8090,10.*:5176,172.*:5176,192.168.*:5176
CORS_ALLOWED_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
CORS_ALLOWED_ORIGIN_PATTERNS=#^http://(10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}):5176$#

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# The Files module's private store (never served, no URLs). Keep it outside the web root; production wiring, encryption and backup are an activation condition (ADR 0153 D2, D7, D12).
FILES_DISK_ROOT=
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Dev redis is a dedicated container (see docker-compose.yml), so collision with
# invoiceflow/crm isn't a concern locally — this just keeps dev matching prod's convention.
REDIS_PREFIX=erp_
# Production shares dbvm's Redis with invoiceflow and crm. REDIS_PREFIX namespaces
# keys but `cache:clear` issues FLUSHDB, which ignores prefixes and would wipe a
# neighbour's cache — so production MUST also give ERP its own database indices,
# agreed with the other two applications. Left unset here because dev has its own
# dedicated Redis container and 0/1 are safe locally.
# REDIS_DB=
# REDIS_CACHE_DB=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LOCAL DEVELOPMENT ONLY: set to true (with APP_ENV=local) to treat the staged quotation view/prepare duties as active, then run
# `php artisan sales:dev-grant-quotation` to grant them to a login. Ignored (and logged) in every other environment.
SALES_DEV_QUOTATION_DUTIES=false
