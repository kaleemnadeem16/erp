# Environment
.env
.env.*
!.env.example
!backend/.env.example

# Backend (Laravel)
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitkeep
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitkeep
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitkeep
backend/storage/framework/views/*
!backend/storage/framework/views/.gitkeep
backend/storage/framework/phpstan/
backend/storage/framework/entrypoint.lock
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/bootstrap/cache/*.php
backend/public/storage
backend/public/hot
backend/.phpunit.cache/
# Intermediate codegen artifact — orval consumes it directly in the same CI step;
# only orval's output (frontend/packages/core-api) is committed.
backend/storage/api-docs/

# Frontend
# npm workspaces can nest node_modules under any package/app, not just the root
# (e.g. a version change that doesn't re-hoist cleanly) — ignore all of them.
frontend/**/node_modules/
frontend/**/dist/
frontend/**/.vite/

# Playwright (frontend/apps/e2e) — run output and the saved login session,
# never fixtures to commit.
frontend/apps/e2e/test-results/
frontend/apps/e2e/playwright-report/
frontend/apps/e2e/blob-report/
frontend/apps/e2e/.auth/

# Docker
logs/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
