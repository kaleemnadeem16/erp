# Production env file for docker-compose.prod.yml — copy to `.env` on mainvm, outside git.
# Never commit the real `.env`. See docs/architecture/ci-cd.md#secrets.

APP_NAME=ERP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-erp.x1techs.com
FRONTEND_URL=https://erp.x1techs.com

LOG_CHANNEL=stack
LOG_LEVEL=info

# dbvm — shared PostgreSQL, not a database this compose file provisions.
# See docs/architecture/environments.md#dbvm--data-tier. "dbvm" only resolves
# in an SSH config alias, not inside mainvm's containers — use dbvm's private
# VCN IP directly (confirmed 2026-09-22 from invoiceflow-backend's own env,
# which uses this same address).
DB_CONNECTION=pgsql
DB_HOST=10.0.1.88
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp_app
DB_PASSWORD=

# dbvm — shared Redis. REDIS_PREFIX is required: this instance is also used by
# invoiceflow and crm, and an unset prefix risks key collisions.
REDIS_HOST=10.0.1.88
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=erp_
# Assigned 2026-09-22: invoiceflow and crm are both still in development and
# neither sets REDIS_DB/REDIS_CACHE_DB explicitly (Laravel's own defaults are
# 0/1), so 3/4 don't collide with either today. This only reserves indices for
# ERP — it does not touch invoiceflow's or crm's own config. Re-confirm with
# whoever owns them once either goes to production, in case they then claim
# explicit indices of their own.
REDIS_DB=3
REDIS_CACHE_DB=4

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=.x1techs.com
# The session/XSRF-TOKEN cookies need the Secure flag on an HTTPS site.
SESSION_SECURE_COOKIE=true
# The container is only reachable through Traefik, so every request arrives
# via a trusted proxy — see backend/bootstrap/app.php.
TRUSTED_PROXIES=*

SANCTUM_STATEFUL_DOMAINS=erp.x1techs.com
CORS_ALLOWED_ORIGINS=https://erp.x1techs.com
